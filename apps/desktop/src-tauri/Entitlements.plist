<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Applied to every binary Tauri signs, including the bundled Python sidecar.
    The sidecar is a PyInstaller bundle: it dlopens a Python framework and
    extension modules signed by other teams (library validation would refuse
    them under the hardened runtime), and numba/llvmlite JIT-compile into
    executable memory. These are the standard entitlements for a Python
    runtime inside a hardened, notarisable app.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
