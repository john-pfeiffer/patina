{
  "name": "main",
  "target": "branch",
  "source_type": "Repository",
  "source": "john-pfeiffer/patina",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Sidecar tests (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "Sidecar tests (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "Sidecar tests (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "UI typecheck, tests, build",
            "integration_id": 15368
          },
          {
            "context": "Dev build (macOS)",
            "integration_id": 15368
          },
          {
            "context": "Dev build (Windows)",
            "integration_id": 15368
          },
          {
            "context": "Dev build (Linux)",
            "integration_id": 15368
          },
          {
            "context": "Release source",
            "integration_id": 15368
          }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ]
}
